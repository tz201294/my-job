# Copy to backend/.env for local runs without Docker (python -m uvicorn app.main:app --reload).
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./myjob.db
SEED_DEMO_DATA=true

# Production: ENVIRONMENT=production, a random SECRET_KEY (32+ chars), SEED_DEMO_DATA=false and the real
# frontend origin(s), e.g. BACKEND_CORS_ORIGINS=["https://myjob.example.com"]
# SECRET_KEY=

# Email: without BREVO_API_KEY, emails (confirmation and reset links) are printed to the API's log instead.
# BREVO_API_KEY=
# EMAIL_FROM=
# FRONTEND_URL=http://localhost:3000

# Optional error reporting: the DSN of a Sentry project (docs/DEPLOY.md step 4). Empty = off.
# SENTRY_DSN=
